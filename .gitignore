# Ignore the node_modules directory, which contains installed dependencies.
node_modules/

# Ignore test result artifacts generated by Playwright.
test-results/

# Ignore the HTML test report generated by Playwright.
playwright-report/

# Ignore binary reports created by Playwright (used for trace debugging).
blob-report/

# Ignore Playwright’s internal cache directory.
playwright/.cache/

# Ignore possible actions files that Playwright creates.
# This exercise uses a pre-existing autograding workflow instead.
.github/workflows/*.yml
